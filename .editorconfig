# EditorConfig — keep the tree consistent across editors/OSes
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# trailing spaces can be meaningful (hard line breaks)
trim_trailing_whitespace = false

[*.sql]
indent_size = 4
